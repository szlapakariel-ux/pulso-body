generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PSYCHOLOGIST
}

enum MediaType {
  AUDIO
  VIDEO
  PHOTO
}

enum TranscriptionStatus {
  NOT_REQUESTED
  PENDING
  COMPLETED
  FAILED
}

enum AiStatus {
  NOT_REQUESTED
  PENDING
  COMPLETED
  FAILED
}

enum SummaryChannel {
  MANUAL
  WHATSAPP
  EMAIL
}

enum EntryKind {
  GENERIC
  MEAL
}

enum MealSlot {
  BREAKFAST
  SNACK_AM
  LUNCH
  SNACK_PM
  DINNER
  CUSTOM
}

enum MeasurementType {
  WEIGHT
  WAIST
  HIP
  CHEST
  ARM
  NECK
  THIGH
  BODY_FAT
  PROGRESS_PHOTO
  CUSTOM
}

enum ExerciseType {
  WALK
  RUN
  BIKE
  STRENGTH
  MOBILITY
  SPORT
  CUSTOM
}

enum ExerciseIntensity {
  LOW
  MEDIUM
  HIGH
  CUSTOM
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile       PatientProfile?       @relation("UserPatientProfile")
  patientsAsPsych      PatientProfile[]      @relation("PsychPatients")
  entriesAsPatient     TimelineEntry[]       @relation("EntriesAsPatient")
  entriesAsPsych       TimelineEntry[]       @relation("EntriesAsPsych")
  notes                PrivateNote[]
  transcriptRequests   Transcription[]
  dailySummarySettings DailySummarySettings?
  measurementsAsPatient MeasurementEntry[]   @relation("MeasurementsAsPatient")
  measurementsAsPsych   MeasurementEntry[]   @relation("MeasurementsAsPsych")
  exercisesAsPatient    ExerciseEntry[]      @relation("ExercisesAsPatient")
  exercisesAsPsych      ExerciseEntry[]      @relation("ExercisesAsPsych")
  mealSchedulesAsPatient MealSchedule[]      @relation("MealSchedulesAsPatient")
  mealSchedulesAsPsych   MealSchedule[]      @relation("MealSchedulesAsPsych")
  nutritionPlansAsPatient NutritionPlan[]    @relation("NutritionPlansAsPatient")
  nutritionPlansAsPsych   NutritionPlan[]    @relation("NutritionPlansAsPsych")
  goalPlansAsPatient      GoalPlan[]         @relation("GoalPlansAsPatient")
  goalPlansAsPsych        GoalPlan[]         @relation("GoalPlansAsPsych")
  trainingPlansAsPatient  TrainingPlan[]     @relation("TrainingPlansAsPatient")
  trainingPlansAsPsych    TrainingPlan[]     @relation("TrainingPlansAsPsych")
}

model PatientProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  psychologistId String
  heightCm       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User @relation("UserPatientProfile", fields: [userId], references: [id], onDelete: Cascade)
  psychologist User @relation("PsychPatients", fields: [psychologistId], references: [id])

  @@index([psychologistId])
}

model TimelineEntry {
  id             String    @id @default(cuid())
  patientId      String
  psychologistId String
  title          String
  mediaType      MediaType
  mediaKey       String
  mediaUrl       String?
  recordedAt     DateTime?
  contextLabel   String?
  contextNote    String?
  aiTitle        String?
  aiSummary      String?
  aiStatus       AiStatus  @default(NOT_REQUESTED)
  entryKind      EntryKind @default(GENERIC)
  mealSlot       MealSlot?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient       User           @relation("EntriesAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist  User           @relation("EntriesAsPsych", fields: [psychologistId], references: [id])
  notes         PrivateNote[]
  transcription Transcription?

  @@index([patientId, createdAt])
  @@index([psychologistId, createdAt])
}

model PrivateNote {
  id             String   @id @default(cuid())
  entryId        String
  psychologistId String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entry        TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  psychologist User          @relation(fields: [psychologistId], references: [id])

  @@index([entryId])
}

model Transcription {
  id            String              @id @default(cuid())
  entryId       String              @unique
  requestedById String
  status        TranscriptionStatus @default(NOT_REQUESTED)
  text          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  entry       TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requestedBy User          @relation(fields: [requestedById], references: [id])
}

model MeasurementEntry {
  id             String          @id @default(cuid())
  patientId      String
  psychologistId String
  type           MeasurementType
  value          Float?
  unit           String?
  mediaKey       String?
  mediaType      MediaType?
  note           String?
  recordedAt     DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient      User @relation("MeasurementsAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("MeasurementsAsPsych", fields: [psychologistId], references: [id])

  @@index([patientId, recordedAt])
  @@index([psychologistId, recordedAt])
}

model ExerciseEntry {
  id              String             @id @default(cuid())
  patientId       String
  psychologistId  String
  type            ExerciseType
  durationMinutes Int?
  intensity       ExerciseIntensity?
  note            String?
  mediaKey        String?
  mediaType       MediaType?
  recordedAt      DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  patient      User @relation("ExercisesAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("ExercisesAsPsych", fields: [psychologistId], references: [id])

  @@index([patientId, recordedAt])
  @@index([psychologistId, recordedAt])
}

model MealSchedule {
  id             String         @id @default(cuid())
  patientId      String
  psychologistId String
  mealSlot       MealSlot
  label          String?
  targetTime     String
  daysOfWeek     Int[]
  status         ScheduleStatus @default(ACTIVE)
  startsAt       DateTime?
  endsAt         DateTime?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User @relation("MealSchedulesAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("MealSchedulesAsPsych",   fields: [psychologistId], references: [id])

  @@index([patientId, status])
  @@index([psychologistId, status])
}

model NutritionPlan {
  id             String         @id @default(cuid())
  patientId      String
  psychologistId String
  title          String
  goal           String?
  generalNotes   String?
  startsAt       DateTime       @default(now())
  endsAt         DateTime?
  status         ScheduleStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User            @relation("NutritionPlansAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User            @relation("NutritionPlansAsPsych",   fields: [psychologistId], references: [id])
  guidelines   MealGuideline[]

  @@index([patientId, status])
  @@index([psychologistId, status])
}

model MealGuideline {
  id              String   @id @default(cuid())
  nutritionPlanId String
  mealSlot        MealSlot
  title           String?
  description     String
  exampleMenu     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan NutritionPlan @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)

  @@index([nutritionPlanId])
}

model GoalPlan {
  id             String         @id @default(cuid())
  patientId      String
  psychologistId String
  title          String
  startsAt       DateTime       @default(now())
  status         ScheduleStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User         @relation("GoalPlansAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User         @relation("GoalPlansAsPsych",   fields: [psychologistId], references: [id])
  weeklyGoals  WeeklyGoal[]

  @@index([patientId, status])
  @@index([psychologistId, status])
}

model WeeklyGoal {
  id         String         @id @default(cuid())
  goalPlanId String
  weekNumber Int
  what       String
  why        String?
  how        String?
  comments   String?
  status     ScheduleStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  goalPlan GoalPlan @relation(fields: [goalPlanId], references: [id], onDelete: Cascade)

  @@index([goalPlanId])
}

model TrainingPlan {
  id             String         @id @default(cuid())
  patientId      String
  psychologistId String
  title          String
  notes          String?
  daysPerWeek    Int?
  startsAt       DateTime       @default(now())
  endsAt         DateTime?
  status         ScheduleStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      User           @relation("TrainingPlansAsPatient", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User           @relation("TrainingPlansAsPsych",   fields: [psychologistId], references: [id])
  days         TrainingDay[]

  @@index([patientId, status])
  @@index([psychologistId, status])
}

model TrainingDay {
  id             String   @id @default(cuid())
  trainingPlanId String
  dayNumber      Int
  title          String?
  warmup         String?
  cooldown       String?
  notes          String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan      TrainingPlan           @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercises ExercisePrescription[]

  @@index([trainingPlanId])
}

model ExercisePrescription {
  id              String   @id @default(cuid())
  trainingDayId   String
  name            String
  muscleGroup     String?
  sets            Int?
  reps            Int?
  durationSeconds Int?
  notes           String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  day TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)

  @@index([trainingDayId])
}

model DailySummarySettings {
  id             String         @id @default(cuid())
  psychologistId String         @unique
  channel        SummaryChannel @default(MANUAL)
  sendTime       String         @default("08:00")
  timezone       String         @default("America/Argentina/Buenos_Aires")
  enabled        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}
